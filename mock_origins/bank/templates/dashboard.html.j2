<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{ acct.bank }} — Accounts</title>
  <style>
    body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; background: #f4f7f5; margin: 0; }
    header { background: #14532d; color: #fff; padding: 16px 28px; }
    .wrap { max-width: 720px; margin: 24px auto; }
    .acct { background: #fff; border-radius: 10px; padding: 18px 22px; margin-bottom: 14px;
            box-shadow: 0 2px 10px rgba(0,0,0,.06); }
    .bal { font-size: 26px; font-weight: 700; color: #14532d; }
    .muted { color: #667; font-size: 14px; }
  </style>
</head>
<body>
  <header><strong>🏦 {{ acct.bank }}</strong> — Welcome back, {{ acct.holder }}</header>
  <div class="wrap">
    <div class="acct">
      <div class="muted">Checking {{ acct.checking_no }}</div>
      <div class="bal">{{ acct.checking_balance }}</div>
    </div>
    <div class="acct">
      <div class="muted">Savings {{ acct.savings_no }}</div>
      <div class="bal">{{ acct.savings_balance }}</div>
    </div>
    <p class="muted">Account holder: {{ acct.holder }} · {{ acct.bank }}</p>
  </div>
</body>
</html>
